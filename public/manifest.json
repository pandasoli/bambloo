{
	"manifest_version": 3,
	"name": "Bambloo",
	"description": "Let your Discord friends knwo what's in your browser",
	"version": "1.0.0",

	"action": {
		"default_title": "Share what you are up to on Discord",
		"default_popup": "index.html",
		"default_icon": {
			"16": "popup-logo/icon-16.png",
			"32": "popup-logo/icon-32.png",
			"48": "popup-logo/icon-48.png",
			"128": "popup-logo/icon-128.png"
		}
	},

	"icons": {
		"16": "popup-logo/icon-16.png",
		"32": "popup-logo/icon-32.png",
		"48": "popup-logo/icon-48.png",
		"128": "popup-logo/icon-128.png"
	},

	"permissions": ["nativeMessaging", "storage", "offscreen", "tabs", "activeTab"],

	"background": {
		"service_worker": "src/background.ts",
		"type": "module"
	},

	"host_permissions": [
		"http://*/*",
		"https://*/*"
	]
}
